# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="NexusCollab - Inter-College Collaboration Network"
VERSION="1.0.0"

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/collabnet
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collabnet

# Redis Configuration (Match Caching)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=collabnet-super-secure-production-jwt-secret-key-384bit
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Algorithmic Complementarity Engine S(A, B) Weights
WEIGHT_COMPLEMENTARITY=0.40
WEIGHT_GOAL_ALIGNMENT=0.25
WEIGHT_RESOURCE_AVAILABILITY=0.20
WEIGHT_TRUST_VERIFICATION=0.15
EXPLORATION_BOOST_MULTIPLIER=1.15
